# YouTube Data API v3（異常値発掘パイプライン用）
YOUTUBE_API_KEY=

# YouTube OAuth 2.0 投稿・管理基盤（2チャンネル分離認証・誤爆防止）
# client_secret.json とトークンは必ず .gitignore 対象のローカル秘匿ディレクトリに配置する
YOUTUBE_OAUTH_CLIENT_SECRET_PATH=pipeline/.secrets/client_secret.json
YOUTUBE_OAUTH_TOKEN_DIR=pipeline/.secrets/youtube_tokens
# 任意：configs/channels.yaml の expected_channel_id を環境変数で上書きする場合（UC...）
YOUTUBE_CHANNEL_ID_CH1_BUGURU=
YOUTUBE_CHANNEL_ID_CH2_AKAPEN=

# LLM / 動画解析 / 画像生成（使用するプロバイダのみ設定）
GEMINI_API_KEY=
# 任意：TTS/API 429 自動フェイルオーバー用サブキー（未設定時は単一キーで動作）
GEMINI_API_KEY_FALLBACK=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 音声合成・STT（使用するプロバイダのみ設定）
ELEVENLABS_API_KEY=
# 任意：ElevenLabs ボイス上書き（未設定時は configs/stack.yaml 既定の Liam / TX3LPaxmHKxFdv7VOQHJ。"auto" でアカウント内自動選定）
ELEVENLABS_VOICE_ID=
AIVIS_API_KEY=

# B-Roll 外部APIゲートウェイ（必要時のみ）
FAL_API_KEY=

# 任意：設定上書き（デフォルトは configs/ 参照）
YT_ENGINE_ENV=local
YT_ENGINE_DB_PATH=pipeline/data/pipeline.db
