  "subtitles": [
    {
      "startSec": 0.15,
      "endSec": 6.07,
      "line1": "もしあなたが160万円のバッグを売るなら、",
      "line2": "いちばん大事な客は誰でしょう？"
    },
    {
      "startSec": 6.46,
      "endSec": 9.3,
      "line1": "普通に考えれば、お金持ちです。"
    },
    {
      "startSec": 9.3,
      "endSec": 14.42,
      "line1": "ところが本物の大富豪ほど、",
      "line2": "ロゴの目立つバッグを持ちたがりません。"
    },
    {
      "startSec": 14.42,
      "endSec": 20.14,
      "line1": "この業界を太く支えているのは、",
      "line2": "お金持ちに見られたい普通の会社員のほうです。"
    },
    {
      "startSec": 20.33,
      "endSec": 26.11,
      "line1": "世界の高級ブランド市場は、",
      "line2": "2024年でおよそ60兆円。"
    },
    {
      "startSec": 26.11,
      "endSec": 31.73,
      "line1": "その45パーセントを、上位わずか",
      "line2": "2パーセントの超富裕層が落としています。"
    },
    {
      "startSec": 31.73,
      "endSec": 36.61,
      "line1": "ところが残りの98パーセント、",
      "line2": "3億5000万人を超える、"
    },
    {
      "startSec": 36.61,
      "endSec": 40.65,
      "line1": "背伸びして買う人たちが、",
      "line2": "売上の半分以上を払っています。"
    },
    {
      "startSec": 40.84,
      "endSec": 44.16,
      "line1": "その背伸びの代金は、どこへ行くのか。"
    },
    {
      "startSec": 44.16,
      "endSec": 46.8,
      "line1": "ルイ・ヴィトンを抱える",
      "line2": "エルブイエムエイチでは、"
    },
    {
      "startSec": 46.8,
      "endSec": 51.6,
      "line1": "革製品部門の営業利益率が",
      "line2": "37.1パーセントもあります。"
    },
    {
      "startSec": 51.6,
      "endSec": 57.04,
      "line1": "100円売れるたびに37円が残る、",
      "line2": "普通のアパレルの数倍の儲けです。"
    },
    {
      "startSec": 57.04,
      "endSec": 61.92,
      "line1": "しかも値札は上がり続け、",
      "line2": "シャネルの定番バッグは5年でほぼ2倍、"
    },
    {
      "startSec": 61.92,
      "endSec": 64.68,
      "line1": "日本では160万円を超えました。"
    },
    {
      "startSec": 64.87,
      "endSec": 67.63,
      "line1": "ここで、妙なことが起きます。"
    },
    {
      "startSec": 67.63,
      "endSec": 71.99,
      "line1": "2022年からの2年間で、",
      "line2": "値上げと物価高についていけない"
    },
    {
      "startSec": 71.99,
      "endSec": 78.11,
      "line1": "約5000万人が、この市場を去りました。",
      "line2": "普通なら値下げを考える場面です。"
    },
    {
      "startSec": 78.11,
      "endSec": 81.99,
      "line1": "ところがブランドが選んだのは、",
      "line2": "もう一段の値上げでした。"
    },
    {
      "startSec": 82.18,
      "endSec": 87.02,
      "line1": "この謎は、2010年の",
      "line2": "マーケティング研究ですんなり解けます。"
    },
    {
      "startSec": 87.02,
      "endSec": 91.26,
      "line1": "買い手を資産の多さと",
      "line2": "見せびらかしたい気持ちで4つに分けると、"
    },
    {
      "startSec": 91.26,
      "endSec": 95.58,
      "line1": "本当の資産家ほどロゴのない地味な品を",
      "line2": "選んでいました。"
    },
    {
      "startSec": 95.58,
      "endSec": 100.38,
      "line1": "素材や仕立ての違いは、",
      "line2": "同じ階層の人に伝われば足りるからです。"
    },
    {
      "startSec": 100.38,
      "endSec": 104.42,
      "line1": "大きなロゴを欲しがったのは、",
      "line2": "上にいると見せたい人たちです。"
    },
    {
      "startSec": 104.58,
      "endSec": 110.553,
      "line1": "経済学者のヴェブレンも1899年に、",
      "line2": "高いこと自体が価値になる品が"
    },
    {
      "startSec": 110.553,
      "endSec": 114.66,
      "line1": "あると書いています。",
      "line2": "値上げは客をふるい落としつつ、"
    },
    {
      "startSec": 114.66,
      "endSec": 119.54,
      "line1": "残った客に、自分はまだ買える側だと",
      "line2": "思わせる仕掛けでもあるわけです。"
    },
    {
      "startSec": 119.73,
      "endSec": 122.65,
      "line1": "日本だと、もっとよく見えます。"
    },
    {
      "startSec": 122.65,
      "endSec": 127.05,
      "line1": "実質賃金が伸び悩む中でも、",
      "line2": "銀座の店には行列ができ、"
    },
    {
      "startSec": 127.05,
      "endSec": 130.65,
      "line1": "SNSには開封動画が流れ続けています。"
    },
    {
      "startSec": 130.65,
      "endSec": 134.57,
      "line1": "一生もの、資産価値、自分へのご褒美。"
    },
    {
      "startSec": 134.57,
      "endSec": 141.65,
      "line1": "そこに来月また値上げという噂が重なると、",
      "line2": "バッグは無理でも財布なら、と手が伸びます。"
    },
    {
      "startSec": 141.84,
      "endSec": 146.04,
      "line1": "売上の半分近くは、",
      "line2": "たしかに大富豪が払っています。"
    },
    {
      "startSec": 146.04,
      "endSec": 152.76,
      "line1": "ただ、憧れを値札に変えられるのは、",
      "line2": "それを見上げる何億人もの財布があるからです。"
    },
    {
      "startSec": 152.76,
      "endSec": 157.8,
      "line1": "では、5000万人を失っても崩れない値札は、",
      "line2": "どう決まっているのか。"
    },
    {
      "startSec": 157.8,
      "endSec": 161.04,
      "line1": "そして次に狙われるのは、",
      "line2": "誰の財布なのか。"
    }
  ],
