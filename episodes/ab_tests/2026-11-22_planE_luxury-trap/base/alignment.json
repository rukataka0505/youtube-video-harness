      "alignmentSource": "elevenlabs_with_timestamps",
      "provider": "elevenlabs",
      "modelUsed": "eleven_v4",
      "voice": "TX3LPaxmHKxFdv7VOQHJ"
    },
    "seg_03_market": {
      "text": "世界の高級ブランド市場は、2024年でおよそ60兆円。その45パーセントを、上位わずか2パーセントの超富裕層が落としています。ところが残りの98パーセント、3億5000万人を超える、背伸びして買う人たちが、売上の半分以上を払っています。",
      "startSec": 20.33,
      "speechEndSec": 40.49,
      "endSec": 40.84,
      "durationSec": 20.16,
      "pauseSec": 0.35,
      "internalPausesSec": [
        20.896,
        22.4213,
        23.8544,
        24.5047,
        24.8119,
        25.6043,
        27.5373,
