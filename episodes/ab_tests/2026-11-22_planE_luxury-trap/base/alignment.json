      "alignmentSource": "elevenlabs_with_timestamps",
      "provider": "elevenlabs",
      "modelUsed": "eleven_v4",
      "voice": "TX3LPaxmHKxFdv7VOQHJ"
    },
    "seg_04_margin": {
      "text": "その背伸びの代金は、どこへ行くのか。ルイ・ヴィトンを抱えるエルブイエムエイチでは、革製品部門の営業利益率が37.1パーセントもあります。100円売れるたびに37円が残る、普通のアパレルの数倍の儲けです。しかも値札は上がり続け、シャネルの定番バッグは5年でほぼ2倍、日本では160万円を超えました。",
      "startSec": 40.84,
      "speechEndSec": 64.52,
      "endSec": 64.87,
      "durationSec": 23.68,
      "pauseSec": 0.35,
      "internalPausesSec": [
        42.425,
