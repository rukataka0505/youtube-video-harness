  "chunks": {
    "seg_01_hook": {
      "text": "もしあなたが160万円のバッグを売るなら、いちばん大事な客は誰でしょう？",
      "startSec": 0.15,
      "speechEndSec": 5.91,
      "endSec": 6.46,
      "durationSec": 5.76,
      "pauseSec": 0.55,
      "internalPausesSec": [
        1.2333,
        1.5314,
        2.7148,
        3.6573
      ],
      "alignmentSource": "elevenlabs_with_timestamps",
      "provider": "elevenlabs",
      "modelUsed": "eleven_v4",
      "voice": "TX3LPaxmHKxFdv7VOQHJ"
    },
    "seg_02_vhs_flip": {
      "text": "普通に考えれば、お金持ちです。ところが本物の大富豪ほど、ロゴの目立つバッグを持ちたがりません。この業界を太く支えているのは、お金持ちに見られたい普通の会社員のほうです。",
      "startSec": 6.46,
      "speechEndSec": 19.98,
      "endSec": 20.33,
      "durationSec": 13.52,
      "pauseSec": 0.35,
      "internalPausesSec": [
        7.7968,
        7.9704,
        9.0552,
