      ],
      "alignmentSource": "elevenlabs_with_timestamps",
      "provider": "elevenlabs",
      "modelUsed": "eleven_v4",
      "voice": "TX3LPaxmHKxFdv7VOQHJ"
    },
    "seg_05_dropout": {
      "text": "ここで、妙なことが起きます。2022年からの2年間で、値上げと物価高についていけない約5000万人が、この市場を去りました。普通なら値下げを考える場面です。ところがブランドが選んだのは、もう一段の値上げでした。",
      "startSec": 64.87,
      "speechEndSec": 81.83,
      "endSec": 82.18,
