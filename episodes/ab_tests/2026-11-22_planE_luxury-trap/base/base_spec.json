          "eventKey": "priceTrendSec",
          "minOffsetFromPrevSec": 1.2,
          "subtitle": {
            "line1": "しかも値札は上がり続け、",
            "line2": "シャネルの定番バッグは5年でほぼ2倍、"
          }
        },
        {
          "charIndex": 132,
