{
  "name": "yt-video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion 2D motion graphics studio for Japanese faceless long-form YouTube production",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render",
    "typecheck": "tsc --noEmit",
    "typecheck:chapter": "node scripts/typecheck-chapter.mjs",
    "bake:backgrounds": "node scripts/bake_backgrounds.mjs",
    "audit:plan-e": "tsx scripts/audit-plan-e.ts",
    "test:plan-e": "tsx --test src/components/plan_e/__tests__/planE.test.ts src/components/plan_e/__tests__/planEStage.test.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
